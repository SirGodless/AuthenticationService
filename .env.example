# Kopieren nach .env und echte Werte eintragen. .env gehört nie ins Git.

# Passwort der Datenbank. Erzeugen: openssl rand -base64 24
DB_PASSWORD=bitte-aendern

# Schlüssel für die TOTP-Geheimnisse, genau 32 Byte als Base64. Erzeugen: openssl rand -base64 32
# Nach dem Setup nie ändern: Sonst sind die gespeicherten 2FA-Geheimnisse unlesbar.
TOTP_ENCRYPTION_KEY=bitte-aendern

# Feste Adresse des Auth-Dienstes (steht auch im Setup-Link). Ohne Slash am Ende.
PUBLIC_BASE_URL=https://auth.anfall.net

# Name in der Authenticator-App
TOTP_ISSUER=anfall.net

# Passwort-Hashing (Argon2id). Die Werte sind der Start, nicht der Mindestwert.
# Der Dienst startet nicht mit weniger als 19456 KiB, 2 Durchläufen und Parallelität 1.
# Beim Start steht im Log, wie lange ein Hash dauert. Ziel grob 100 bis 500 ms.
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=1
