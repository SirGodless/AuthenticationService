# Block für deinen bestehenden Caddy. Du trägst ihn selbst in die Caddyfile ein (ich ändere deine Caddy-Konfiguration nicht).
# Voraussetzung: Caddy läuft im Docker-Netzwerk, das du bei ./setup.sh gewählt hast (dort erreicht er die Container beim Namen).
# Danach prüfen: caddy validate --config /etc/caddy/Caddyfile, dann neu laden.

# Hub, Login, Registrierung, Dashboard und die OIDC-Schnittstellen der Dienste: alles unter anfall.net.
# Diese Adresse ist der Issuer der Tokens und darf sich nie ändern.
anfall.net {
	encode zstd gzip

	# HTTPS erzwingt Caddy von selbst. HSTS sagt dem Browser, es künftig immer zu tun.
	# Bewusst ohne includeSubDomains: Die Adresse ist die Hauptdomain, und sonst würde es für jede Subdomain gelten
	# (auch für eine, die vielleicht noch ohne HTTPS läuft).
	header Strict-Transport-Security "max-age=31536000"

	# Alles, was zum Backend gehört: OIDC (Discovery, Authorize, Token, JWKS, UserInfo, Logout) und die API.
	# Der Verwaltungs-Port 8081 des Backends (Health) wird absichtlich nicht weitergegeben.
	@backend path /oauth2/* /.well-known/* /connect/* /userinfo /api/*
	handle @backend {
		reverse_proxy auth-backend:8080
	}

	# Alles andere sind die statischen Seiten der Oberfläche.
	handle {
		reverse_proxy userhub-ui:8080
	}
}

# www leitet auf die Hauptadresse um.
www.anfall.net {
	header Strict-Transport-Security "max-age=31536000"
	redir https://anfall.net{uri} permanent
}
