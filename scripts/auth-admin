#!/bin/sh
# Betreiber-Befehle im Backend-Container (siehe README):
#   docker compose exec auth-backend auth-admin reset-2fa <username>
# Startet das Backend ohne Webserver, führt den Befehl aus und beendet sich.
exec java -XX:MaxRAMPercentage=50 -jar /app/app.jar \
  --spring.main.web-application-type=none --spring.main.banner-mode=off \
  --logging.level.root=WARN --app.cli.enabled=true "$@"
